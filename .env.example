# SliceOS backend API base URL
# Copy to `.env.local` for local overrides (`.env.local` is gitignored).

# Azure dev Functions app (default for frontend local dev):
VITE_API_BASE_URL=https://func-sliceos-api-dev-5663.azurewebsites.net

# Local Functions host (when running backend with `func start` on port 7071):
# VITE_API_BASE_URL=http://localhost:7071

# CORS: the browser sends requests from http://localhost:5173. The API must allow that
# origin in Azure App Service CORS (backend infra: Cors__AllowedOrigin). If you see blocked
# requests in DevTools, add http://localhost:5173 to the Function App CORS settings.
